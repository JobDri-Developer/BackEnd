APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod
IMAGE_NAME=ghcr.io/jobdri-developer/backend
IMAGE_TAG=latest
WORKER_IMAGE_NAME=ghcr.io/jobdri-developer/analysis-worker
WORKER_IMAGE_TAG=latest

DB_URL=jdbc:postgresql://your-db-host:5432/jobdri
DB_USERNAME=jobdri
DB_PASSWORD=change-me
DB_DRIVER=org.postgresql.Driver
JPA_DDL_AUTO=update
SPRING_JPA_DEFER_DATASOURCE_INITIALIZATION=true

REDIS_HOST=your-upstash-host
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_SSL_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=jobdri
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_PORT=15672

JWT_SECRET_KEY=base64-encoded-secret
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=jobdri.official@gmail.com
MAIL_PASSWORD=change-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000

GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me
APP_OAUTH2_REDIRECT_URI=https://your-frontend-domain/oauth2/redirect
OPENAI_API_KEY=change-me
COHERE_API_KEY=
APP_LOG_PATH=/var/log/spring-boot
APP_AUDIT_LOG_PATH=/var/log/spring-boot/audit

TOSS_CLIENT_KEY=change-me
TOSS_SECRET_KEY=change-me
TOSS_BASE_URL=https://api.tosspayments.com
TOSS_PAY_API_BASE_URL=https://pay.toss.im
TOSS_PAY_API_KEY=change-me
TOSS_PAY_RETURN_URL=https://jobdri.site/credit/payment-result
TOSS_PAY_CANCEL_URL=https://jobdri.site/credit/payment-canceldi
TOSS_PAY_RESULT_CALLBACK_URL=https://api.jobdri.site/api/payments/toss/callback
PAYMENT_COUPON_CODE=ABCD-EFGH-IJKL

AWS_REGION=ap-northeast-2
S3_BUCKET=your-s3-bucket
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
S3_PRESIGN_GET_EXPIRATION_MINUTES=10
S3_PRESIGN_PUT_EXPIRATION_MINUTES=5
JOB_POSTING_IMAGE_UPLOAD_MAX_SIZE_BYTES=5242880

JOB_POSTING_CLASSIFICATION_CONFIDENCE_THRESHOLD=0.65
APP_WORKER_EXCHANGE=jobdri.worker.exchange
APP_WORKER_INTERNAL_API_KEY=change-me-internal-worker-key
WORKER_SPRING_API_BASE_URL=http://api:8080
APP_WORKER_JOB_POSTING_EXCHANGE=${APP_WORKER_EXCHANGE}
APP_WORKER_JOB_POSTING_QUEUE=jobdri.job-posting.ingest
APP_WORKER_JOB_POSTING_ROUTING_KEY=job-posting.ingest
APP_WORKER_JOB_POSTING_DLQ=jobdri.job-posting.ingest.dlq
APP_WORKER_JOB_POSTING_MAX_RETRY_COUNT=3
APP_WORKER_JOB_POSTING_QUEUE_TIMEOUT_MINUTES=10
APP_WORKER_JOB_POSTING_PROCESSING_TIMEOUT_MINUTES=20
APP_WORKER_ANALYSIS_EXCHANGE=${APP_WORKER_EXCHANGE}
APP_WORKER_ANALYSIS_QUEUE=jobdri.analysis.execute
APP_WORKER_ANALYSIS_ROUTING_KEY=analysis.execute
APP_WORKER_ANALYSIS_DLQ=jobdri.analysis.execute.dlq
APP_WORKER_ANALYSIS_MAX_RETRY_COUNT=3
APP_WORKER_ANALYSIS_QUEUE_TIMEOUT_MINUTES=10
APP_WORKER_ANALYSIS_PROCESSING_TIMEOUT_MINUTES=20
APP_WORKER_ANALYSIS_QUEUE_TIMEOUT_MILLIS=300000
WORKER_PREFETCH_COUNT=1
OPENAI_JOB_POSTING_MODEL=gpt-4o-mini
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
WORKER_MAX_RETRY_COUNT=3
JOB_POSTING_ASYNC_CORE_POOL_SIZE=2
JOB_POSTING_ASYNC_MAX_POOL_SIZE=4
JOB_POSTING_ASYNC_QUEUE_CAPACITY=20
MAIL_ASYNC_CORE_POOL_SIZE=1
MAIL_ASYNC_MAX_POOL_SIZE=2
MAIL_ASYNC_QUEUE_CAPACITY=50

MANAGEMENT_HEALTH_SHOW_DETAILS=never
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
